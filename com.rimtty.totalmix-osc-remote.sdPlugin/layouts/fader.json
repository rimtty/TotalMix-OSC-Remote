{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "tmx-fader",
  "items": [
    {
      "key": "title",
      "type": "text",
      "rect": [16, 10, 136, 24],
      "font": { "size": 16, "weight": 600 },
      "alignment": "left"
    },
    {
      "key": "icon",
      "type": "pixmap",
      "rect": [16, 40, 48, 48]
    },
    {
      "key": "value",
      "type": "text",
      "rect": [76, 40, 108, 32],
      "font": { "size": 22, "weight": 600 },
      "alignment": "right",
      "color": "#F5A623"
    },
    {
      "key": "indicator",
      "type": "bar",
      "rect": [76, 76, 108, 12],
      "subtype": 4,
      "border_w": 0,
      "bar_bg_c": "0:#2A2A2E,1:#2A2A2E",
      "bar_fill_c": "#F5A623",
      "range": { "min": 0, "max": 100 },
      "value": 0
    }
  ]
}
