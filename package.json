{
  "name": "totalmix-osc-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stream Deck plugin to control RME TotalMix FX via OSC (true Float32 faders)",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "images": "node scripts/export-images.mjs",
    "validate": "streamdeck validate com.rimtty.totalmix-osc-remote.sdPlugin"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^24.0.0",
    "rollup": "^4.24.0",
    "sharp": "^0.34.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
